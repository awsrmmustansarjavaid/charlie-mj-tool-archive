{
  "manifest_version": 3,
  "name": "Charlie MJ Tool Archive",
  "version": "6.1.3",
  "description": "Local-first personal resource manager with IndexedDB, portable category JSON storage, bundled profile transfer, and resilient Settings rendering.",
  "permissions": [
    "alarms",
    "bookmarks",
    "contextMenus",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "Open Charlie MJ Tool Archive",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/dashboard.html",
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Open Charlie MJ Tool Archive v6.1.2"
    }
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "omnibox": {
    "keyword": "cmj"
  },
  "version_name": "6.1.3 \u2014 Transfer Profile & Settings Renderer Hotfix"
}
